{
  "name": "arveland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/db-provider.mjs && prisma generate && next dev",
    "build": "node scripts/db-provider.mjs && prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/db-provider.mjs && prisma db push",
    "db:studio": "prisma studio",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "db:reset": "node scripts/db-provider.mjs && prisma db push --force-reset && npm run seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.6.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs"
  }
}
