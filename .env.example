# --- Local development (SQLite) ---
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# --- Production on Vercel (Neon / Vercel Postgres) ---
# Only these two are needed — the Prisma provider is inferred from the URL scheme.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# AUTH_SECRET="<openssl rand -base64 32>"
#
# Optional override, only if the URL scheme is not enough:
# DATABASE_PROVIDER="postgresql"

# Optional: used by `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Resend — outgoing email (optional; without it the send button reports it is unconfigured)
# RESEND_API_KEY="re_..."
# SENDER_EMAIL="info@example.com"
# SENDER_NAME="Example"
